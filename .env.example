# Copy to .env (never commit .env). Everything is optional; defaults shown.

# ---------- RAG ----------
RAG_DOCUMENTS_PATH=data/processed/documents_clean.jsonl
RAG_COLLECTION=uk_pension_chunks
RAG_QDRANT_PATH=data/qdrant
# RAG_QDRANT_URL=http://localhost:6333        # use a Qdrant server instead of the local folder
# RAG_QDRANT_API_KEY=
RAG_CHUNK_TARGET_TOKENS=500                   # measured best of 250/350/500 on our evaluation set
RAG_CHUNK_OVERLAP_TOKENS=75
RAG_RETRIEVAL_MODE=hybrid                     # dense | bm25 | hybrid
RAG_DEDUPE=true
RAG_MAX_PER_DOC=2
RAG_TOP_K=5
RAG_MIN_SCORE=0.2                             # abstention threshold; recalibrate after changing the embedder

# Embeddings: hashing (offline baseline) | gemini | sentence-transformers
RAG_EMBEDDING_PROVIDER=hashing
RAG_EMBEDDING_MODEL=hashing-word-1-2gram
RAG_EMBEDDING_DIM=2048
# After switching the provider run:  python -m src.rag.ingest --rebuild-collection

# ---------- Gemini (optional) ----------
# GEMINI_API_KEY=                             # paste your key HERE only, never in code or chat
# GEMINI_MODEL=                               # current model name from Google AI Studio (needed for answers/rewrite/rerank)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001 # verify this is current for your account
# GEMINI_EMBED_DIM=
# GEMINI_MIN_INTERVAL_SECONDS=4               # ~15 calls/minute
# GEMINI_DAILY_CAP=450

# ---------- Answer writer ----------
LLM_PROVIDER=none                             # none (quoted passages) | gemini | ollama
# OLLAMA_MODEL=pension-slm
# OLLAMA_URL=http://localhost:11434

# ---------- API ----------
API_SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password-here
ALLOW_REGISTRATION=false
CORS_ORIGINS=http://localhost:5173

# ---------- Optional answer-quality switches (each adds model calls per question; measure before keeping) ----------
RAG_USE_JUDGE=false            # true: ask the model "do these passages answer the question?" before answering
RAG_RERANK=off                 # off | llm  (llm reorders the top candidates with the model)
DEBUG_RAW_REPLIES=false        # true: show the model's raw reply in the API/UI "How this answer was made" panel (debugging only)
